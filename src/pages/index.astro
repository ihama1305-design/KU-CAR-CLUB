---
import '@fontsource/barlow-condensed/latin-700.css';
import '@fontsource/dm-sans/latin-400.css';
import '../styles/landing.css';
import {event,branches,memories,locations,contributors} from '../data/landing';
const base=import.meta.env.BASE_URL;
const img=(id:string)=>`${base}media/${id}-800.webp`;
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>KU Car Club — Driven together.</title><meta name="description" content="Student-run. Majlis-backed. Open to everyone. KU Car Club at Khalifa University, Abu Dhabi."/></head><body>
<a class="skip" href="#club">Skip to content</a><header><a class="wordmark" href="#home">KU<span>CAR CLUB<small>KHALIFA UNIVERSITY</small></span></a><nav aria-label="Main navigation"><a href="#club">The club</a><a href="#explore">Explore UAE</a><a href="#together">Our people</a></nav><a class="nav-event" href="#next-event">Next meet ↗</a></header>
<main><section class="hero" id="home"><img class="hero-photo" src={`${base}media/landing-hero-1600.webp`} srcset={`${base}media/landing-hero-600.webp 600w, ${base}media/landing-hero-1000.webp 1000w, ${base}media/landing-hero-1600.webp 1600w`} sizes="100vw" alt="Blue sports coupe with white headlights under cinematic night lighting" fetchpriority="high"/><div class="hero-shade"></div><div class="hero-copy"><p class="eyebrow"><i></i> ABU DHABI, UAE · STUDENT DRIVEN</p><h1>DRIVEN<br/><span>TOGETHER.</span></h1><p>A shared love of cars. A night worth showing up for.<br/>This is KU Car Club.</p><a class="primary" href="#club">Explore the club <span>↗</span></a></div><div class="hero-bottom"><span>KU STUDENTS × ABU DHABI MOTOR MAJLIS</span><span>SCROLL TO GET CLOSER ↓</span></div><span class="hero-side">EST. ON CAMPUS / MADE FOR EVERYONE</span></section>
<section class="event panel" id="next-event" data-event={JSON.stringify(event)}><div><p class="eyebrow">UP NEXT <span class="blue">/ SAVE THE NIGHT</span></p><h2>{event.name}</h2><p>Good cars. Good people. Come through.</p></div><div class="event-clock"><p id="date-status">Date to be announced</p><div id="countdown" hidden aria-label="Event countdown"></div><small id="preview-label"></small></div><div class="event-meta"><span>↗ <span id="venue">Venue to be announced</span></span><span><i></i> Free entry</span><span><i></i> Open to everyone</span><span>PRODUCED BY KU STUDENTS. BACKED BY THE MAJLIS.</span></div></section>
<section id="club" class="section gallery-section"><div class="section-top"><p class="eyebrow">01 / THE CLUB, IN MOTION</p><span class="micro">CARS BRING US HERE. PEOPLE KEEP US HERE.</span></div><div class="section-heading"><h2>GOOD COMPANY.<br/><span>GREAT MACHINES.</span></h2><p>We’re students making space for everyone who loves cars.<br/>Come for the line-up. Stay for the conversations.</p></div><div class="branches" role="group" aria-label="Media branches">{branches.map((b,i)=><button data-branch={i} aria-pressed={i===0}>{b}<span> ↗</span></button>)}</div><div class="wheel" tabindex="0" role="region" aria-roledescription="carousel" aria-label="Club media. Use left and right arrow keys."><div class="orbit"></div><div class="branch-line"></div>{memories.map((m,i)=><button class="memory" data-index={i} data-branch-id={m.branch}><img src={img(m.image)} srcset={`${base}media/${m.image}-480.webp 480w, ${base}media/${m.image}-800.webp 800w`} sizes="(max-width:700px) 260px, 370px" loading="lazy" alt={m.title}/><span class="media-tag">{m.video?'▶ CLUB FILM':'↗ PHOTOGRAPH'}</span><span class="memory-title">{m.title}<b>View {m.video?'film':'photo'} ↗</b></span></button>)}</div><div class="wheel-footer"><span>DRAG TO EXPLORE <span class="blue">↔</span></span><div><button id="previous" aria-label="Previous media">←</button><span id="position" aria-live="polite">01 / 03</span><button id="next" aria-label="Next media">→</button></div><span>A DIFFERENT PERSPECTIVE, EVERY TURN.</span></div></section>
<section class="section explore" id="explore"><div class="section-top"><p class="eyebrow">02 / BEYOND CAMPUS</p><span class="micro">SEVEN EMIRATES. SO MUCH TO EXPLORE.</span></div><div class="section-heading"><h2>OUR HOME.<br/><span>YOUR NEXT DISCOVERY.</span></h2><p>From city lights to mountain roads.<br/>A few places we’d love to explore together.</p></div><div class="explorer"><div class="map-stage"><div class="globe" aria-hidden="true"><div>25° N<br/><b>UNITED ARAB EMIRATES</b><br/>54° E</div></div><div class="uae-map"><svg viewBox="0 0 600 430" preserveAspectRatio="none" aria-label="Geographic overview of the UAE" role="img"><defs><pattern id="grid" width="25" height="25" patternUnits="userSpaceOnUse"><path d="M25 0H0V25" fill="none" stroke="#173253" stroke-width=".5"/></pattern></defs><rect width="600" height="430" fill="url(#grid)"/><path class="land" d="M521.35,83.38L528.00,85.56L530.59,101.93L530.94,106.18L531.27,109.76L532.64,112.10L532.65,114.45L530.83,123.34L532.72,145.41L525.74,146.91L525.12,152.40L520.87,155.57L511.23,159.55L507.80,163.71L503.81,168.62L499.23,169.14L491.14,160.25L486.64,154.68L491.49,155.09L492.76,150.35L488.28,146.00L475.87,148.26L468.99,154.22L468.77,166.31L469.09,172.64L468.02,179.66L464.71,185.52L465.97,196.74L469.21,200.05L469.90,206.32L464.09,215.43L472.40,218.61L483.62,217.80L490.67,231.12L469.86,238.17L463.03,236.47L456.00,236.57L446.30,237.93L436.34,241.70L432.17,245.52L439.70,250.87L440.08,262.13L430.40,281.67L424.80,287.13L419.26,302.31L403.07,332.05L403.37,348.83L393.31,370.67L348.04,365.79L302.54,360.89L257.03,355.98L211.52,351.08L166.02,346.19L118.15,341.03L107.44,332.69L90.36,314.91L73.31,297.13L56.24,279.36L39.17,261.58L22.10,243.80L8.57,229.16L8.24,218.08L10.00,207.49L11.17,203.73L13.96,213.85L17.77,216.64L20.65,216.46L22.89,217.76L24.53,216.67L28.23,211.13L29.67,222.04L31.29,230.00L32.41,236.19L36.36,239.37L43.91,240.26L47.60,242.26L47.06,240.04L56.39,239.87L61.90,242.38L69.34,242.09L73.21,241.43L79.02,241.37L86.83,23