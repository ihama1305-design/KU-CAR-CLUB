217.17ZM117.22,206.02L123.76,203.86L125.32,209.31L119.14,214.68L115.21,209.56ZM198.85,213.79L193.75,211.31L186.96,212.04L183.99,212.52L184.11,210.77L188.92,210.65L193.39,209.02L199.59,206.77L202.67,208.77L203.75,206.32L209.10,199.44L209.85,201.46L211.68,206.28L203.98,210.11L199.80,212.37ZM314.46,196.89L313.67,190.77L315.21,190.96L321.97,195.58L322.55,198.68ZM301.79,210.75L298.83,212.02L295.10,209.94L292.30,208.17L294.96,205.09L299.04,206.33L301.79,210.75ZM308.28,203.24L308.23,208.19L303.17,204.06L306.21,204.75L306.54,203.99L305.98,202.01ZM88.34,187.34L90.13,192.96L86.67,192.16L85.35,190.12L88.34,187.34Z"/><text x="70" y="120">ARABIAN GULF</text><text x="200" y="310">UNITED ARAB EMIRATES</text></svg>{locations.map((l,i)=><button class="pin" data-location={i} style={`--pin-index:${i};left:${(l.lon-51.5)/5.5*100}%;top:${(26.5-l.lat)/4.5*100}%`} aria-label={`Explore ${l.name}`}><span></span><small>{l.name}</small></button>)}</div><button id="all-emirates">↖ View all emirates</button><span class="map-note">EXPLORATION IDEAS · NOT CONFIRMED EVENT VENUES</span></div><div class="location-panel"><p class="eyebrow">CHOOSE YOUR NEXT STOP</p><div class="location-list">{locations.map((l,i)=><button data-location={i} aria-pressed={i===0}><span>0{i+1}</span>{l.name}<b>↗</b></button>)}</div><div id="location-detail" aria-live="polite"></div></div></div></section>
<section class="section together" id="together"><div class="section-top"><p class="eyebrow">03 / BUILT TOGETHER</p><span class="micro">ONE IDEA. A WHOLE CREW BEHIND IT.</span></div><div class="section-heading"><h2>STUDENT ENERGY.<br/><span>SHARED AMBITION.</span></h2><p>KU gives us a home. The Majlis backs the production.<br/>We bring the night to life.</p></div><div class="collage"><img class="collage-one" src={img('P04')} loading="lazy" alt="People gathered beside a sports car"/><img class="collage-two" src={`${base}media/hero-poster.jpg`} loading="lazy" alt="A student crew member at a night meet"/><img class="collage-three" src={img('P15')} loading="lazy" alt="McLaren bodywork under event lighting"/><span class="collage-stamp">THE PEOPLE<br/>BEHIND THE NIGHT.<b>KU × ADMM</b></span>{contributors.map((c,i)=><button class={`contributor contributor-${i}`} data-contributor={i}><span>0{i+1} /</span> {c.name} <b>↗</b></button>)}</div><p class="collage-caption">Planning. Lighting. Photos. Sound. Real experience, made together.<span>MEET THE COLLABORATION ↑</span></p></section>
<section class="closing"><p class="eyebrow">NO INVITE NEEDED.</p><h2>YOUR PEOPLE.<br/>YOUR KIND OF NIGHT.</h2><p>Student or visitor. Car person or just curious.<br/>Come along. It’s free, and everyone gets full access.</p><a class="primary" href="#next-event">View next event <span>↗</span></a><span class="closing-watermark" aria-hidden="true">KU</span></section></main><footer><a class="wordmark" href="#home">KU <span>CAR CLUB</span></a><span>STUDENT-RUN. MAJLIS-BACKED. OPEN TO ALL.</span><a href="#home">Back to top ↑</a><small>© {new Date().getFullYear()} KU Car Club</small></footer>
<dialog id="modal" aria-labelledby="modal-title"><button class="close" autofocus aria-label="Close pop-up">Close ×</button><div id="modal-content"></div></dialog><script id="landing-data" type="application/json" set:html={JSON.stringify({memories,locations,contributors,base})}/><script src="../scripts/landing.ts"></script></body></html>



