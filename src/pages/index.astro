---
import Layout from '../layouts/Layout.astro';
import JoinLink from '../components/JoinLink.astro';
import JoinBlock from '../components/JoinBlock.astro';
import Photo from '../components/Photo.astro';
import { CLUB, url } from '../data/club';
const moments=[{id:'P08',number:'01',title:'The after-hours line-up',label:'Shared experiences',filter:'After dark'},{id:'P12',number:'02',title:'A closer look',label:'Details worth discovering',filter:'Details'},{id:'P17',number:'03',title:'Caught in the light',label:'Through the lens',filter:'Daylight'}];
---
<Layout hero>
<section class="hero" aria-labelledby="hero-title"><div class="hero-media"><video id="hero-video" poster={url('media/hero-poster.jpg')} muted autoplay loop playsinline preload="none" data-desktop={url('media/hero-desktop.mp4')} data-mobile={url('media/hero-mobile.mp4')} aria-label="KU Car Club evening gathering"></video><div class="hero-shade"></div><div class="hero-meta"><span><i class="live-dot"></i> THE KU CAR CLUB FILM</span><button id="video-toggle" class="video-toggle" aria-label="Play background video"><span aria-hidden="true">▷</span> Play video</button></div></div><div class="hero-content wrap"><div class="hero-panel"><p class="eyebrow"><span class="little-line"></span> A SHARED PASSION. A NEW CONNECTION.</p><h1 id="hero-title">For the cars.<br/>For the <em>people.</em></h1><p class="hero-name">KU Car Club</p><p class="hero-tagline">Learn, Experience, Connect.</p><div class="hero-actions"><JoinLink id="hero-join"/><a class="button glass" href={url('gallery/')}>Explore the gallery <span aria-hidden="true">↗</span></a></div></div></div><div class="hero-bottom wrap"><span>GOOD CARS. GREAT COMPANY.</span><a href="#community">Discover the club <span aria-hidden="true">↓</span></a></div></section>
<section class="values" aria-label="Our values"><div class="wrap values-grid"><div><span>01 /</span><h2>Learn.</h2><p>Every conversation, a new perspective.</p></div><div><span>02 /</span><h2>Experience.</h2><p>Get closer to the passion we share.</p></div><div><span>03 /</span><h2>Connect.</h2><p>Come for the cars. Stay for the people.</p></div></div></section>
<section class="section community" id="community"><div class="wrap split"><div class="section-copy"><p class="eyebrow">THIS IS KU CAR CLUB</p><h2>A common interest.<br/>An uncommon<br/><span class="muted">connection.</span></h2><p>It starts with a car that catches your eye. A detail you haven’t seen before. A conversation with someone who gets it.</p><p>KU Car Club brings that curiosity together. A space to share what you know, experience something different, and find your people along the way.</p><a class="text-link" href={url('about/')}>Get to know the club <span aria-hidden="true">↗</span></a></div><div class="community-picture"><Photo id="P04" sizes="(max-width: 760px) 100vw, 50vw"/><span class="image-label">IT’S ALWAYS ABOUT THE PEOPLE.</span><div class="image-index">KU / COMMUNITY</div></div></div></section>
<section class="section moments"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">THE THINGS THAT BRING US TOGETHER</p><h2>Club moments<span class="accent">.</span></h2></div><a href={url('gallery/')} class="text-link">See the gallery <span aria-hidden="true">↗</span></a></div><div class="moment-grid">{moments.map(m=><a class="moment-card" href={`${url('gallery/')}?filter=${encodeURIComponent(m.filter)}`}><div class="moment-image"><Photo id={m.id}/><span class="card-number">{m.number}</span></div><div class="card-copy"><p class="eyebrow">{m.label}</p><h3>{m.title}<span aria-hidden="true">↗</span></h3></div></a>)}</div></div></section>
<section class="section featured"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">A FEW THAT CAUGHT OUR EYE</p><h2>In the frame<span class="accent">.</span></h2></div><p>Different cars. Individual stories.<br/>One shared appreciation.</p></div><div class="featured-grid">{['P17','P18','P19','P20','P22','P13'].map((id,i)=><a href={url('gallery/')} class:list={['featured-photo',{'portrait-photo':id==='P13'}]} aria-label={`Explore gallery photograph ${i+1}`}><Photo id={id}/><span>KU / {String(i+1).padStart(2,'0')} <span aria-hidden="true">↗</span></span></a>)}</div><p class="photo-note">Photographs from the supplied KU collection. Original photographer marks retained.</p></div></section>
<section class="events-teaser"><div class="wrap events-inner"><div><p class="eyebrow">THE NEXT GOOD CONVERSATION</p><h2>See you at<br/>the next one.</h2></div><div><p>Looking for the next gathering? Follow <strong>@ku.car.club</strong> on Instagram for the latest club updates.</p><a href={CLUB.instagram} class="button yellow">Follow on Instagram <span aria-hidden="true">↗</span></a><a class="text-link" href={url('events/')}>Club updates <span aria-hidden="true">↗</span></a></div></div></section>
<section class="section film-section"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">LESS SCROLLING. MORE ATMOSPHERE.</p><h2>A night with KU<span class="accent">.</span></h2></div><span class="film-length">THE CLUB FILM / 00:33</span></div><div class="film-wrap"><video id="full-film" controls playsinline preload="none" poster={url('media/P08-1280.jpg')} data-source={url('media/club-film.mp4')} aria-label="Full KU Car Club evening meet film"></video><button class="film-play" id="film-play"><span aria-hidden="true">▶</span> Play the film</button><noscript><a class="button yellow film-noscript" href={url('media/club-film.mp4')}>Watch the club film ↗</a></noscript></div></div></section>
<JoinBlock/>
</Layout>
