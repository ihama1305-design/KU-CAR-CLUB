---
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import JoinLink from '../components/JoinLink.astro';
import { CLUB, url } from '../data/club';
---
<Layout title="Events & club updates"><section class="page-intro wrap"><p class="eyebrow">OUT OF THE FEED. INTO THE MOMENT.</p><h1>Good cars.<br/><span class="muted">Even better company.</span></h1><p>Stay close to what’s happening at KU Car Club.</p></section><section class="section"><div class="wrap split"><Photo id="P08" class="events-photo"/><div class="section-copy"><p class="eyebrow">KEEP IN THE LOOP</p><h2>The next gathering<br/>starts here.</h2><p>No upcoming event details have been published on this site yet. Follow @ku.car.club on Instagram for the latest gathering announcements.</p><a class="button yellow" href={CLUB.instagram}>Instagram updates <span aria-hidden="true">↗</span></a><p>Join the WhatsApp group to connect with the community.</p><JoinLink class="text-link">Join on WhatsApp</JoinLink></div></div></section><div class="wrap end-link"><a class="text-link" href={url('gallery/')}>Explore club moments <span aria-hidden="true">↗</span></a></div></Layout>
