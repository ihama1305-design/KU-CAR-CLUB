---
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import { media } from '../data/media';
import { url } from '../data/club';
---
<Layout title="The gallery"><section class="page-intro wrap"><p class="eyebrow">THE KU CAR CLUB COLLECTION</p><h1>Every angle.<br/><span class="muted">A different story.</span></h1><p>The cars, the details, and the moments in between.</p></section><section class="gallery-section wrap" aria-label="Photo collection"><div class="gallery-toolbar"><div class="gallery-filters" hidden>{['All','Daylight','After dark','Details'].map((tag,i)=><button class:list={['filter',{'selected':i===0}]} data-filter={tag} aria-pressed={i===0}>{tag}</button>)}</div><p id="gallery-count" aria-live="polite">{media.length} photographs</p></div><div class="gallery-grid">{media.map(m=><figure class="gallery-item" data-tag={m.tag}><a href={url(`media/${m.id}-${m.width>=1280?1280:800}.jpg`)} class="gallery-open" data-title={m.title} data-alt={m.alt}><Photo id={m.id}/><span class="gallery-expand" aria-hidden="true">↗</span><span class="sr-only">Open {m.title}</span></a><figcaption><span>{m.title}</span><span>{m.tag}</span></figcaption></figure>)}</div><p id="gallery-empty" hidden>No photographs in this selection. Choose All to view the collection.</p><p class="photo-note">Original photographer marks are retained in the supplied images. Photographed cars are shown as part of the collection; ownership is not implied.</p></section><dialog id="lightbox" aria-label="Photograph viewer"><div class="lightbox-top"><p id="lightbox-title"></p><button id="lightbox-close" aria-label="Close photograph">Close ×</button></div><div class="lightbox-stage"><button id="lightbox-prev" aria-label="Previous photograph">←</button><img id="lightbox-image" src="" alt=""/><button id="lightbox-next" aria-label="Next photograph">→</button></div><p id="lightbox-position" aria-live="polite"></p></dialog></Layout>
